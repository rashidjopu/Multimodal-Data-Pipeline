# ---- LLM Enrichment (stage 2) ----------------------------------------------
LLM_PROVIDER=openai                 # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_ANTHROPIC=claude-sonnet-4-6
LLM_MAX_RETRIES=3
LLM_BATCH_SIZE=10

# ---- Higgsfield Video Generation (stage 3) ---------------------------------
# Leave both blank to automatically fall back to MockHiggsfieldClient
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai/v1
HIGGSFIELD_POLL_INTERVAL_SECONDS=5
HIGGSFIELD_POLL_TIMEOUT_SECONDS=180
SENTIMENT_VIDEO_THRESHOLD=0.8

# ---- Warehouse (stage 4) ----------------------------------------------------
# Local/dev default:
DATABASE_URL=sqlite:///data/warehouse/ecommerce.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ecommerce

# ---- Orchestration ----------------------------------------------------------
AIRFLOW_HOME=.airflow
PIPELINE_SCHEDULE_CRON="0 2 * * *"   # daily at 02:00

# ---- Data Quality ------------------------------------------------------------
GE_DATA_CONTEXT_ROOT=data_quality
FAIL_PIPELINE_ON_DQ_ERROR=true

# ---- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
RANDOM_SEED=42
